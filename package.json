{
  "name": "deskbuddy",
  "version": "0.3.2",
  "description": "A desktop sprite editor and animation launcher.",
  "main": "main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "icon": "node scripts/generate-app-icon.js",
    "demo-gif": "node scripts/generate-demo-gif.js",
    "check": "node --check main.js && node --check preload.js && node --check src/creator.js && node --check src/pet.js && node --check docs/assets/site.js && node --check scripts/generate-app-icon.js && node --check scripts/generate-demo-gif.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.deskbuddy.app",
    "productName": "DeskBuddy",
    "artifactName": "DeskBuddy-${version}-portable.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
